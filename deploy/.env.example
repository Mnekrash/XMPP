# Copy to deploy/.env (git-ignored) and replace every value.
# Generate secrets with: openssl rand -hex 32   (values must not contain "$", quotes or spaces)

# Compose project name (separates environments on one host)
COMPOSE_PROJECT_NAME=messenger-dev
ENVIRONMENT=development            # development | staging | production

# Domains (see docs/05-server.md §2)
XMPP_DOMAIN=chat.example.com
UPLOAD_DOMAIN=upload.example.com

# Caddy TLS: "internal" for development (local CA), or the ACME contact e-mail for staging/production
TLS_MODE=internal

# Images (pinned)
EJABBERD_IMAGE=ejabberd/ecs:26.09
POSTGRES_IMAGE=postgres:17
CADDY_IMAGE=caddy:2

# PostgreSQL
POSTGRES_PASSWORD=change-me-superuser
EJABBERD_DB_NAME=ejabberd
EJABBERD_DB_USER=ejabberd
EJABBERD_DB_PASSWORD=change-me-ejabberd
PUSH_DB_NAME=pushgw
PUSH_DB_USER=pushgw
PUSH_DB_PASSWORD=change-me-pushgw

# XEP-0114 component secret shared by ejabberd and the push gateway
PUSH_COMPONENT_SECRET=change-me-component

# HTTP Upload
UPLOAD_MAX_BYTES=104857600         # 100 MiB (ciphertext)
UPLOAD_RETENTION_DAYS=90

# Push gateway / APNs. The .p8 key lives OUTSIDE the repository, in APNS_SECRETS_DIR on the host,
# mounted read-only at /run/apns in the container. Leave APNS_KEY_FILE empty in development to disable APNs.
# Staging/production example:
#   APNS_SECRETS_DIR=/etc/messenger/apns
#   APNS_KEY_FILE=/run/apns/AuthKey_XXXXXXXXXX.p8
#   APNS_KEY_ID=XXXXXXXXXX
#   APNS_TEAM_ID=XXXXXXXXXX
#   APNS_TOPIC=com.example.messenger        # the app's bundle id
APNS_KEY_FILE=

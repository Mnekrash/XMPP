// Shared build settings. Each environment file includes this first and Local.xcconfig last.

APP_DISPLAY_NAME = Messenger
APP_BUNDLE_ID_PREFIX = com.example.messenger
XMPP_PORT = 5223

// xcconfig treats "//" as a comment, so only host names (never URLs) live here.
XMPP_HOST = $(XMPP_DOMAIN)
MUC_DOMAIN = groups.$(XMPP_DOMAIN)
PUSH_COMPONENT_JID = push.$(XMPP_DOMAIN)
APP_GROUP_ID = group.$(APP_BUNDLE_ID)

// Override in Local.xcconfig (git-ignored): DEVELOPMENT_TEAM, SPIKE_BUNDLE_ID (must equal the gateway's APNS_TOPIC).
SPIKE_BUNDLE_ID = com.example.messenger.dev
SPIKE_APP_GROUP = group.$(SPIKE_BUNDLE_ID)
SPIKE_KEYCHAIN_GROUP = $(SPIKE_BUNDLE_ID).shared
CODE_SIGN_STYLE = Automatic
#include? "Local.xcconfig"
